# E2E test environment — loaded automatically by playwright.config.ts via dotenv.
# All test variables live here. Never hardcode values in spec files.
# This file IS committed (no secrets — only URLs and test params).

# ── Production target site ───────────────────────────────────────────────────
# Base URL of the live WordPress site running PigCache.
PIGCACHE_SITE=https://nuevoleonhoy.com

# ── Production HTML cache test URLs ──────────────────────────────────────────
# Page that triggers the partial-render bug (emoji in path → always LATE cache).
PIGCACHE_URL_BROKEN=https://nuevoleonhoy.com/%F0%9F%8F%86%F0%9F%90%BE%F0%9F%9A%82-todo-o-nada-en-cu-pumas-y-cruz-azul-definen-al-campeon-del-clausura-2026/

# Page that serves correctly (plain ASCII path → EARLY cache).
PIGCACHE_URL_OK=https://nuevoleonhoy.com/canelo-ya-es-el-segundo-deportista-mejor-pagado-del-planeta/

# ── Local Docker test environment (used by CI + db-cache / object-cache specs) ─
# Base URL of the Docker WordPress instance (see tests/docker/docker-compose.yml).
# The port is 9520 by default; if you move it with PIGCACHE_TEST_PORT, override
# these three URLs in tests/.env.tests.local (gitignored) to match.
PIGCACHE_LOCAL_URL=http://localhost:9520

# Plain-slug post created by setup.sh — exercises the EARLY HTML cache path.
PIGCACHE_URL_OK_LOCAL=http://localhost:9520/pigcache-test-article/

# Emoji-slug post — exercises the Bug #2 key-symmetry fix (EARLY vs LATE path).
# The slug must stay non-ASCII: an ASCII slug never reaches the percent-encoding
# path and the test silently stops proving anything.
PIGCACHE_URL_EMOJI_LOCAL=http://localhost:9520/%F0%9F%8F%86-pigcache-emoji/

# ── Thresholds ────────────────────────────────────────────────────────────────
# Minimum article body character count to consider a page fully rendered.
PIGCACHE_MIN_ARTICLE_CHARS=100

# Minimum scroll height ratio between two article pages (0.0–1.0).
# Below this ratio one page is likely partially rendered.
PIGCACHE_MIN_HEIGHT_RATIO=0.30
